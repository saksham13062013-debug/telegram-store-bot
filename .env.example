# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Admin User ID (for admin commands)
ADMIN_USER_ID=your_telegram_user_id

# Database Configuration
# For SQLite (local): sqlite:///store_bot.db
# For PostgreSQL (Railway): postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/database

# Currency Symbol
CURRENCY=$

# Pagination
PRODUCTS_PER_PAGE=5

# Optional: Payment Gateway Keys (if you want to enable payments)
STRIPE_API_KEY=your_stripe_key_here
PAYPAL_API_KEY=your_paypal_key_here
